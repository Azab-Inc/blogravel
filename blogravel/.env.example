APP_NAME=Blogravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Local baseline only. Production: use APP_ENV=production, APP_DEBUG=false,
# and provision APP_KEY through your secret manager (never commit it).

# Compose runtime user/group. Set these to the host user/group IDs for local
# development; keep the values appropriate for the user running the container.
WWWUSER=1000
WWWGROUP=1000

# Set a unique key before starting a non-local deployment:
# php artisan key:generate

# Public tenant hosts use {slug}.${TENANCY_PLATFORM_DOMAIN}.
TENANCY_PLATFORM_DOMAIN=blogravel.com
TENANCY_RESERVED_LABELS=www,admin,api

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=blogravel
DB_USERNAME=sail
# Local Compose-only default. Production: use a strong, unique database password.
DB_PASSWORD=password

# pgAdmin (local DB inspector) — served at http://localhost:${FORWARD_PGADMIN_PORT:-5050}
FORWARD_PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@blogravel.dev
PGADMIN_DEFAULT_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Keep the hosted domain for cross-subdomain sessions. Localhost requests use
# host-only session cookies automatically, so no local SESSION_DOMAIN override
# is needed for localhost or *.localhost. Production: set this to the parent
# domain shared by the app and tenant hosts, for example .example.com.
SESSION_DOMAIN=.blogravel.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=300
AI_GENERATION_QUEUE_POOLS=4

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_CONNECTION=cache
REDIS_CACHE_LOCK_CONNECTION=default

MAIL_MAILER=smtp
MAIL_SCHEME=null
# Mailpit is development-only. Production: use a real SMTP/provider host and
# credentials, such as your transactional email provider.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Optional mail providers. Leave unset when using SMTP or Mailpit.
MAIL_URL=
MAIL_EHLO_DOMAIN=
POSTMARK_API_KEY=
RESEND_API_KEY=

# Tenant host configuration. Public tenant URLs use {slug}.${TENANCY_PLATFORM_DOMAIN}.
OCTANE_SERVER=frankenphp

# Storage and backup configuration. The local disk is suitable for one host;
# production: use durable S3-compatible storage for backups/media and configure
# the bucket, credentials, endpoint, and region below.
BACKUP_DISK=local
BACKUP_PATH=backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional billing. Keep disabled and secrets unset for self-hosted deployments.
BILLING_ENABLED=false
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

# Backup plan limits (used when billing is enabled)
BACKUP_FREE_RETENTION_DAYS=30
BACKUP_FREE_MAX_SIZE_MB=500
BACKUP_PRO_RETENTION_DAYS=120
BACKUP_PRO_MAX_SIZE_MB=2000
BACKUP_BUSINESS_RETENTION_DAYS=120
BACKUP_BUSINESS_MAX_SIZE_MB=5000
